#!/usr/bin/env bash
set -euo pipefail

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="hitl-agent-python-task-queue" AND ExecutionStatus="Completed"' \
    --limit 1 \
    2>/dev/null | grep -c "Completed" || true)

if [[ "${COMPLETED}" -lt 1 ]]; then
    echo "FAIL: No completed workflows found on demo4 task queue yet. Complete a full HITL interaction first."
    exit 1
fi

echo "OK: At least one demo4 workflow completed."
exit 0
