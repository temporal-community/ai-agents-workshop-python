#!/usr/bin/env bash
# Check that the travel planner activity was invoked -- i.e. a workflow completed
# on the orchestrator-tq with an ask_travel_planner activity in its history.
# We check for completed workflows on orchestrator-tq; the participant must have
# run a prompt that triggers the travel planner.
set -euo pipefail

COMPLETED=$(temporal workflow list \
    --address 127.0.0.1:7233 \
    --namespace default \
    --query 'TaskQueue="orchestrator-tq" AND ExecutionStatus="Completed"' \
    --limit 5 \
    2>/dev/null | grep -c "Completed" || true)

if [[ "${COMPLETED}" -lt 1 ]]; then
    echo "FAIL: No completed workflows on orchestrator-tq yet. Run a workflow and wait for it to finish."
    exit 1
fi

echo "OK: At least one demo6 orchestrator workflow completed."
exit 0
