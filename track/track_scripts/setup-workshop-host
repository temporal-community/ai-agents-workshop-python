#!/usr/bin/env bash
# setup-workshop-host
# Runs once at track creation. Bootstraps the full workshop environment.
# NOTE: Runs as root. Working directory is /workspace.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
WORKSPACE=/workspace
F1_MCP_HOME=/root/f1-mcp-server

mkdir -p "${WORKSPACE}"

# 1. System packages
# apt-get update exits 100 on Ubuntu 22.04 due to a non-fatal command-not-found
# post-invoke hook failure. The package lists download correctly so we ignore it.
apt-get update -qq || true
apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    unzip \
    build-essential \
    ca-certificates \
    gnupg \
    bash-completion \
    python3-venv \
    python3-dev \
    python3-pip

# Make python resolve to the system python3 (3.10 on Ubuntu 22.04)
update-alternatives --install /usr/bin/python python /usr/bin/python3 1
python --version

# 2. uv - install to /usr/local/bin so it is on PATH for all users and services
curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
uv --version

# 3. Node.js 20 (required by f1-mcp-server)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# 4. Temporal CLI
curl -sSf https://temporal.download/cli.sh | sh
chmod +x /root/.temporalio/bin/temporal
ln -sf /root/.temporalio/bin/temporal /usr/local/bin/temporal
export PATH="${PATH}:/root/.temporalio/bin:/usr/local/bin"
temporal --version

# 5. Clone workshop repo (instruqt branch)
git clone \
    --branch instruqt \
    https://github.com/temporal-community/ai-agents-workshop-python.git \
    "${WORKSPACE}/workshop"

# 6. Install Python dependencies for all four demos
for demo in demo1-agentic-loop demo2-openai-temporal-integration demo3-mcp demo4-hitl; do
    pushd "${WORKSPACE}/workshop/${demo}"
    uv sync
    popd
done

# 7. F1 MCP server (rakeshgangwar/f1-mcp-server, pinned commit)
#    COMMIT PIN: Update this SHA before each workshop by running:
#        git ls-remote https://github.com/rakeshgangwar/f1-mcp-server HEAD
F1_MCP_COMMIT=73b95ecf75fcabbd25c68c3a57e784e529beb421

git clone https://github.com/rakeshgangwar/f1-mcp-server.git "${F1_MCP_HOME}"
pushd "${F1_MCP_HOME}"
git checkout "${F1_MCP_COMMIT}"

# Patch the hardcoded Mac cache path in f1_data.py.
sed -i "s|fastf1.Cache.enable_cache.*|import os\n_cache_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'cache')\nos.makedirs(_cache_dir, exist_ok=True)\nfastf1.Cache.enable_cache(_cache_dir)|" python/f1_data.py

npm install
npm run build

python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install fastf1 pandas numpy

popd

# 8. Pre-warm FastF1 cache
mkdir -p "${F1_MCP_HOME}/cache"
"${F1_MCP_HOME}/.venv/bin/python" - <<'EOF'
import fastf1
import os
cache_dir = '/root/f1-mcp-server/cache'
os.makedirs(cache_dir, exist_ok=True)
fastf1.Cache.enable_cache(cache_dir)
try:
    session = fastf1.get_session(2024, 'Monaco', 'R')
    session.load(telemetry=False, weather=False, messages=False)
    print("FastF1 cache warm: Monaco 2024 Race loaded OK")
except Exception as e:
    print(f"FastF1 cache warm failed (non-fatal): {e}")
EOF

# 9. mitmproxy + network control panel
python3 -m venv /opt/mitmproxy-venv
/opt/mitmproxy-venv/bin/pip install --upgrade pip
/opt/mitmproxy-venv/bin/pip install mitmproxy flask
ln -sf /opt/mitmproxy-venv/bin/mitmdump /usr/local/bin/mitmdump

# Start mitmproxy briefly to generate the CA cert, then stop it.
mitmdump --listen-port 8889 --set block_global=false &
MITM_PID=$!
sleep 4
kill $MITM_PID 2>/dev/null || true
wait $MITM_PID 2>/dev/null || true

MITM_CA_PEM="/root/.mitmproxy/mitmproxy-ca-cert.pem"

# Trust the mitmproxy CA cert system-wide
cp "$MITM_CA_PEM" /usr/local/share/ca-certificates/mitmproxy-ca.crt
update-ca-certificates

# Append the mitmproxy CA cert to the certifi bundle inside each demo venv.
# httpx uses certifi's bundled CA store, not the system truststore, so we must
# add the cert there directly.
for demo in demo1-agentic-loop demo2-openai-temporal-integration demo3-mcp demo4-hitl; do
    CERTIFI_BUNDLE="${WORKSPACE}/workshop/${demo}/.venv/lib/python3.10/site-packages/certifi/cacert.pem"
    if [[ -f "$CERTIFI_BUNDLE" ]]; then
        cat "$MITM_CA_PEM" >> "$CERTIFI_BUNDLE"
        echo "Appended mitmproxy CA to certifi bundle in ${demo}"
    else
        echo "WARNING: certifi bundle not found in ${demo} at ${CERTIFI_BUNDLE}"
    fi
done

# Write the mitmproxy addon script
mkdir -p /workspace/proxy

cat > /workspace/proxy/toggle_addon.py <<'PYEOF'
"""
mitmproxy addon: reads /workspace/proxy/state.json and blocks or passes
outbound requests based on which service groups are toggled off.

State file format:
{
  "kill_all": false,
  "services": {
    "openai":      true,
    "weather":     true,
    "geolocation": true,
    "ipinfo":      true,
    "f1":          true
  }
}
A value of true means the service is ALLOWED through.
"""
import json
from mitmproxy import http

STATE_FILE = "/workspace/proxy/state.json"

SERVICE_HOSTS = {
    "openai":      ["api.openai.com"],
    "weather":     ["api.open-meteo.com", "geocoding-api.open-meteo.com"],
    "geolocation": ["ip-api.com"],
    "ipinfo":      ["icanhazip.com"],
    "f1":          ["ergast.com", "api.openf1.org", "livetiming.formula1.com"],
}

DEFAULT_STATE = {
    "kill_all": False,
    "services": {k: True for k in SERVICE_HOSTS},
}


def _load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return DEFAULT_STATE


def request(flow: http.HTTPFlow) -> None:
    state = _load_state()
    host = flow.request.pretty_host

    if state.get("kill_all"):
        flow.response = http.Response.make(
            503, b"[Workshop proxy] All external services disabled.", {"Content-Type": "text/plain"}
        )
        return

    services = state.get("services", {})
    for key, hostnames in SERVICE_HOSTS.items():
        if not services.get(key, True):
            if any(h in host for h in hostnames):
                flow.response = http.Response.make(
                    503,
                    f"[Workshop proxy] Service '{key}' is currently disabled.".encode(),
                    {"Content-Type": "text/plain"},
                )
                return
PYEOF

cat > /workspace/proxy/state.json <<'EOF'
{
  "kill_all": false,
  "services": {
    "openai": true,
    "weather": true,
    "geolocation": true,
    "ipinfo": true,
    "f1": true
  }
}
EOF

# mitmproxy systemd service
cat > /etc/systemd/system/workshop-proxy.service <<'PROXYSVC'
[Unit]
Description=Workshop Network Proxy (mitmproxy)
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/mitmdump \
    --listen-port 8888 \
    --set block_global=false \
    --set ssl_insecure=false \
    -s /workspace/proxy/toggle_addon.py
Restart=on-failure
RestartSec=3
StandardOutput=append:/workspace/proxy/proxy.log
StandardError=append:/workspace/proxy/proxy.log

[Install]
WantedBy=multi-user.target
PROXYSVC

# Flask control panel
cat > /workspace/proxy/controlpanel.py <<'PYEOF'
"""
Tiny Flask app that serves the network control panel UI.
Reads and writes /workspace/proxy/state.json.
Served on port 5000.
"""
import json
import os
from flask import Flask, jsonify, request, send_from_directory

app = Flask(__name__, static_folder="/workspace/proxy/static")
STATE_FILE = "/workspace/proxy/state.json"

DEFAULT_STATE = {
    "kill_all": False,
    "services": {
        "openai": True,
        "weather": True,
        "geolocation": True,
        "ipinfo": True,
        "f1": True,
    },
}

SERVICE_LABELS = {
    "openai":      "OpenAI  (api.openai.com)",
    "weather":     "Weather  (api.open-meteo.com)",
    "geolocation": "Geolocation  (ip-api.com)",
    "ipinfo":      "IP Info  (icanhazip.com)",
    "f1":          "F1 Data  (ergast.com / api.openf1.org)",
}


def read_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return dict(DEFAULT_STATE)


def write_state(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


@app.route("/")
def index():
    return send_from_directory("/workspace/proxy/static", "index.html")


@app.route("/api/state", methods=["GET"])
def get_state():
    return jsonify(read_state())


@app.route("/api/state", methods=["POST"])
def set_state():
    state = request.get_json(force=True)
    write_state(state)
    return jsonify({"ok": True})


@app.route("/api/service/<key>", methods=["POST"])
def toggle_service(key):
    data = request.get_json(force=True)
    state = read_state()
    state["services"][key] = bool(data.get("enabled", True))
    write_state(state)
    return jsonify({"ok": True, "key": key, "enabled": state["services"][key]})


@app.route("/api/kill_all", methods=["POST"])
def kill_all():
    data = request.get_json(force=True)
    state = read_state()
    state["kill_all"] = bool(data.get("enabled", False))
    write_state(state)
    return jsonify({"ok": True, "kill_all": state["kill_all"]})


@app.route("/api/labels", methods=["GET"])
def labels():
    return jsonify(SERVICE_LABELS)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
PYEOF

