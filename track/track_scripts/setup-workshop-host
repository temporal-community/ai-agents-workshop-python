#!/usr/bin/env bash
# setup-workshop-host
# Runs once at track creation. Bootstraps the full workshop environment.
# Runtime: ~5-8 minutes depending on FastF1 cache warm.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
HOME_DIR=/home/user
WORKSHOP_ROOT=${HOME_DIR}/workshop
F1_MCP_HOME=${HOME_DIR}/f1-mcp-server

# ---------------------------------------------------------------------------
# 1. System packages
# ---------------------------------------------------------------------------
apt-get update -qq
apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    unzip \
    build-essential \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common

# ---------------------------------------------------------------------------
# 2. Python 3.11 (via deadsnakes PPA — Ubuntu 22.04 ships 3.10, uv needs 3.10+)
# ---------------------------------------------------------------------------
add-apt-repository -y ppa:deadsnakes/ppa
apt-get update -qq
apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev

# Make python3 / python resolve to 3.11
update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# ---------------------------------------------------------------------------
# 3. uv (fast Python package manager used by all demos)
# ---------------------------------------------------------------------------
curl -LsSf https://astral.sh/uv/install.sh | sh
# Add uv to PATH for all subsequent steps and for user shells
export PATH="${HOME_DIR}/.local/bin:${PATH}"
echo 'export PATH="/home/user/.local/bin:$PATH"' >> /etc/environment
echo 'export PATH="/home/user/.local/bin:$PATH"' >> "${HOME_DIR}/.bashrc"

# ---------------------------------------------------------------------------
# 4. Node.js 20 (required by f1-mcp-server)
# ---------------------------------------------------------------------------
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# ---------------------------------------------------------------------------
# 5. Temporal CLI
# ---------------------------------------------------------------------------
TEMPORAL_VERSION="1.1.2"
curl -sSf https://temporal.download/cli.sh | sh -s -- --version "${TEMPORAL_VERSION}"
temporal --version

# ---------------------------------------------------------------------------
# 6. Clone workshop repo (instruqt branch)
# ---------------------------------------------------------------------------
git clone \
    --branch instruqt \
    https://github.com/temporal-community/ai-agents-workshop-python.git \
    "${WORKSHOP_ROOT}"

chown -R user:user "${WORKSHOP_ROOT}"

# ---------------------------------------------------------------------------
# 7. Install Python dependencies for all four demos
#    uv sync in each demo directory pre-populates the .venv and uv cache so
#    participants don't wait for downloads during the session.
# ---------------------------------------------------------------------------
for demo in demo1-agentic-loop demo2-openai-temporal-integration demo3-mcp demo4-hitl; do
    pushd "${WORKSHOP_ROOT}/${demo}"
    sudo -u user uv sync
    popd
done

# ---------------------------------------------------------------------------
# 8. F1 MCP server (rakeshgangwar/f1-mcp-server, pinned commit)
#    ⚠️  COMMIT PIN: Update this SHA before each workshop by running:
#        git ls-remote https://github.com/rakeshgangwar/f1-mcp-server HEAD
# ---------------------------------------------------------------------------
F1_MCP_COMMIT=73b95ecf75fcabbd25c68c3a57e784e529beb421

git clone https://github.com/rakeshgangwar/f1-mcp-server.git "${F1_MCP_HOME}"
pushd "${F1_MCP_HOME}"
git checkout "${F1_MCP_COMMIT}"

# Build the Node.js TypeScript server
npm install
npm run build

# Create the Python venv that the Node process shells out to for FastF1
python3.11 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install fastf1 pandas numpy

popd
chown -R user:user "${F1_MCP_HOME}"

# ---------------------------------------------------------------------------
# 9. F1_MCP_SERVER_HOME env var — worker.py reads this
# ---------------------------------------------------------------------------
echo "export F1_MCP_SERVER_HOME=${F1_MCP_HOME}" >> /etc/environment
echo "export F1_MCP_SERVER_HOME=${F1_MCP_HOME}" >> "${HOME_DIR}/.bashrc"

# ---------------------------------------------------------------------------
# 10. Pre-warm FastF1 cache for a recent known race
#     FastF1 downloads ~50MB of timing data on first access; doing it now
#     means demo3/4 don't stall on the first participant workflow.
#     Uses the 2024 Monaco GP (always available, stable data).
# ---------------------------------------------------------------------------
"${F1_MCP_HOME}/.venv/bin/python" - <<'EOF'
import fastf1
fastf1.Cache.enable_cache('/home/user/.cache/fastf1')
try:
    session = fastf1.get_session(2024, 'Monaco', 'R')
    session.load(telemetry=False, weather=False, messages=False)
    print("FastF1 cache warm: Monaco 2024 Race loaded OK")
except Exception as e:
    print(f"FastF1 cache warm failed (non-fatal): {e}")
EOF

# ---------------------------------------------------------------------------
# 11. code-server (VS Code in the browser)
# ---------------------------------------------------------------------------
CODE_SERVER_VERSION="4.22.1"
curl -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_amd64.deb" \
    -o /tmp/code-server.deb
dpkg -i /tmp/code-server.deb
rm /tmp/code-server.deb

# Configure code-server: no auth, open to workshop root
mkdir -p "${HOME_DIR}/.config/code-server"
cat > "${HOME_DIR}/.config/code-server/config.yaml" <<CSCFG
bind-addr: 0.0.0.0:8080
auth: none
cert: false
CSCFG

# Systemd service for code-server
cat > /etc/systemd/system/code-server.service <<CSSVC
[Unit]
Description=code-server
After=network.target

[Service]
Type=simple
User=user
Environment="PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/code-server --config /home/user/.config/code-server/config.yaml ${WORKSHOP_ROOT}
Restart=always

[Install]
WantedBy=multi-user.target
CSSVC

systemctl daemon-reload
systemctl enable code-server
systemctl start code-server

# ---------------------------------------------------------------------------
# 12. Temporal dev server systemd service
#     Starts automatically so it's ready when challenge 00 opens.
# ---------------------------------------------------------------------------
cat > /etc/systemd/system/temporal-dev-server.service <<TSVC
[Unit]
Description=Temporal Dev Server
After=network.target

[Service]
Type=simple
User=user
Environment="PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/local/bin/temporal server start-dev --ui-port 8233
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
TSVC

systemctl daemon-reload
systemctl enable temporal-dev-server
systemctl start temporal-dev-server

# ---------------------------------------------------------------------------
# 13. Write OPENAI_API_KEY from Instruqt secret into environment
#     Instruqt injects $INSTRUQT_SECRET_OPENAI_API_KEY at provisioning time.
#     We persist it to /etc/environment and .bashrc so it's available in
#     every terminal and systemd service that needs it.
# ---------------------------------------------------------------------------
if [[ -n "${INSTRUQT_SECRET_OPENAI_API_KEY:-}" ]]; then
    echo "export OPENAI_API_KEY=${INSTRUQT_SECRET_OPENAI_API_KEY}" >> /etc/environment
    echo "export OPENAI_API_KEY=${INSTRUQT_SECRET_OPENAI_API_KEY}" >> "${HOME_DIR}/.bashrc"
    echo "OPENAI_API_KEY injected from Instruqt secret"
else
    echo "WARNING: INSTRUQT_SECRET_OPENAI_API_KEY not set — participants will need to export it manually"
fi

chown -R user:user "${HOME_DIR}"

echo "=== setup-workshop-host complete ==="
