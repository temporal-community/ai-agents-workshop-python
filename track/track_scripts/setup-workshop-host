    --radius: 10px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    padding: 32px 24px;
  }
  h1 { font-size: 1.3rem; font-weight: 600; margin-bottom: 4px; }
