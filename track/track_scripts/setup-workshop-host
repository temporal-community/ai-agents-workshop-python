#!/usr/bin/env bash
# setup-workshop-host
# Runs once at track creation. Bootstraps the full workshop environment.
# NOTE: Runs as root. Working directory is /workspace.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
WORKSPACE=/workspace
F1_MCP_HOME=/root/f1-mcp-server

mkdir -p "${WORKSPACE}"

# 1. System packages
apt-get update -qq
apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    unzip \
    build-essential \
    ca-certificates \
    gnupg \
    bash-completion \
    python3-venv \
    python3-dev

# Make python resolve to the system python3 (3.10 on Ubuntu 22.04)
update-alternatives --install /usr/bin/python python /usr/bin/python3 1
python --version

# 2. uv - install to /usr/local/bin so it is on PATH for all users and services
curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
uv --version

# 3. Node.js 20 (required by f1-mcp-server)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# 4. Temporal CLI
curl -sSf https://temporal.download/cli.sh | sh
chmod +x /root/.temporalio/bin/temporal
ln -sf /root/.temporalio/bin/temporal /usr/local/bin/temporal
export PATH="${PATH}:/root/.temporalio/bin:/usr/local/bin"
temporal --version

# 5. Clone workshop repo (instruqt branch)
git clone \
    --branch instruqt \
    https://github.com/temporal-community/ai-agents-workshop-python.git \
    "${WORKSPACE}/workshop"

# 6. Install Python dependencies for all four demos
for demo in demo1-agentic-loop demo2-openai-temporal-integration demo3-mcp demo4-hitl; do
    pushd "${WORKSPACE}/workshop/${demo}"
    uv sync
    popd
done

# 7. F1 MCP server (rakeshgangwar/f1-mcp-server, pinned commit)
#    COMMIT PIN: Update this SHA before each workshop by running:
#        git ls-remote https://github.com/rakeshgangwar/f1-mcp-server HEAD
F1_MCP_COMMIT=73b95ecf75fcabbd25c68c3a57e784e529beb421

git clone https://github.com/rakeshgangwar/f1-mcp-server.git "${F1_MCP_HOME}"
pushd "${F1_MCP_HOME}"
git checkout "${F1_MCP_COMMIT}"

# Patch the hardcoded Mac cache path in f1_data.py.
# The upstream repo has fastf1.Cache.enable_cache('~/Documents/Cline/...') which
# does not exist on the VM. The sed command below replaces that line with one
# that resolves the cache directory relative to f1_data.py itself, landing at
# /root/f1-mcp-server/cache/ -- the same path the pre-warm step uses below.
sed -i "s|fastf1.Cache.enable_cache.*|import os\n_cache_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'cache')\nos.makedirs(_cache_dir, exist_ok=True)\nfastf1.Cache.enable_cache(_cache_dir)|" python/f1_data.py

npm install
npm run build

python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install fastf1 pandas numpy

popd

# 8. Pre-warm FastF1 cache into /root/f1-mcp-server/cache/ -- the same location
#    the patched f1_data.py uses. This avoids cold-cache timeouts during demos.
mkdir -p "${F1_MCP_HOME}/cache"
"${F1_MCP_HOME}/.venv/bin/python" - <<'EOF'
import fastf1
import os
cache_dir = '/root/f1-mcp-server/cache'
os.makedirs(cache_dir, exist_ok=True)
fastf1.Cache.enable_cache(cache_dir)
try:
    session = fastf1.get_session(2024, 'Monaco', 'R')
    session.load(telemetry=False, weather=False, messages=False)
    print("FastF1 cache warm: Monaco 2024 Race loaded OK")
except Exception as e:
    print(f"FastF1 cache warm failed (non-fatal): {e}")
EOF

# 9. code-server
curl -fsSL https://code-server.dev/install.sh | sh

mkdir -p /root/.local/share/code-server/User
cat > /root/.local/share/code-server/User/settings.json <<'SETTINGS'
{
    "workbench.colorTheme": "Default Dark+",
    "workbench.startupEditor": "none",
    "security.workspace.trust.enabled": false,
    "editor.fontSize": 14,
    "editor.tabSize": 4,
    "workbench.activityBar.visible": false,
    "workbench.statusBar.visible": true
}
SETTINGS

cat > /etc/systemd/system/code-server.service <<'CSSVC'
[Unit]
Description=code-server
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/code-server --host 0.0.0.0 --port 8080 --auth none /workspace/workshop
Restart=always

[Install]
WantedBy=multi-user.target
CSSVC

# 10. Temporal dev server systemd service
cat > /etc/systemd/system/temporal-dev-server.service <<'TSVC'
[Unit]
Description=Temporal Dev Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/temporal server start-dev --ui-port 8233 --ip 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=append:/workspace/temporal.log
StandardError=append:/workspace/temporal.log

[Install]
WantedBy=multi-user.target
TSVC

systemctl daemon-reload
systemctl enable code-server
systemctl start code-server
systemctl enable temporal-dev-server
systemctl start temporal-dev-server

echo "Waiting for Temporal server..."
for i in $(seq 1 30); do
    if temporal operator cluster health --address 127.0.0.1:7233 2>/dev/null | grep -q SERVING; then
        echo "Temporal server healthy."
        break
    fi
    sleep 3
done

# 11. Shell environment via /etc/bash.bashrc
cat >> /etc/bash.bashrc <<'BASHRC'

# Workshop environment
export PATH=$PATH:/root/.temporalio/bin:/usr/local/bin
export TEMPORAL_ADDRESS="127.0.0.1:7233"
export F1_MCP_SERVER_HOME=/root/f1-mcp-server
export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi
BASHRC

# 12. OPENAI_API_KEY from Instruqt secret
if [[ -n "${INSTRUQT_SECRET_OPENAI_API_KEY:-}" ]]; then
    echo "OPENAI_API_KEY=${INSTRUQT_SECRET_OPENAI_API_KEY}" >> /etc/environment
    echo "export OPENAI_API_KEY=${INSTRUQT_SECRET_OPENAI_API_KEY}" >> /etc/bash.bashrc
    echo "OPENAI_API_KEY injected from Instruqt secret"
else
    echo "WARNING: INSTRUQT_SECRET_OPENAI_API_KEY not set"
fi

echo "=== setup-workshop-host complete ==="
